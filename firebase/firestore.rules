rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read/write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // FCM registration tokens for geofence push notifications. Only the owner
      // writes them; the geofence Cloud Function reads them via the Admin SDK.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Child account documents.
    match /children/{childId} {
      // Any signed-in user may read a child doc. This is needed so a parent can
      // verify a scanned pairing code before linking. Tighten in production by
      // moving linking to a Cloud Function (then restrict reads to linkedParents).
      allow read: if request.auth != null;

      // The child device owns its document.
      allow create, update, delete: if request.auth != null && request.auth.uid == childId;

      // A signed-in parent may link themselves while pairing is active, and may
      // ONLY change the linkedParents field.
      allow update: if request.auth != null
                    && resource.data.pairingActive == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParents']);

      // A linked parent may remove (unlink) themselves, updating linkedParents
      // (and re-opening pairing); they must not remain linked afterwards.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.linkedParents
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParents', 'pairingActive'])
                    && !(request.auth.uid in request.resource.data.linkedParents);

      // App usage rules: a linked parent or the child may read/write.
      match /appRules/{packageName} {
        allow read, write: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
      }

      // App inventory: the child writes it; a linked parent (or the child) reads it.
      match /inventory/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null && request.auth.uid == childId;
      }

      // Geofences: a linked parent authors them; the child reads them.
      match /geofences/{geoId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
      }

      // Screen-time usage: the child writes it; a linked parent reads it.
      match /usage/{date} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null && request.auth.uid == childId;
      }

      // Live device state (location + ring command): a linked parent or the
      // child may read and write (child publishes location & clears rings; parent
      // reads location & sends rings).
      match /live/{docId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
      }

      // Location trail (continuous path): the child appends points; a linked parent reads.
      match /trail/{date} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null && request.auth.uid == childId;
      }

      // Travel history: the child records stops; a linked parent reads them.
      match /travelHistory/{stopId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow create: if request.auth != null && request.auth.uid == childId;
      }

      // Anti-tamper protection settings: a linked parent writes them (toggle +
      // PIN); the child reads them to enforce uninstall protection.
      match /settings/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents;
      }

      // Auto-blocked new apps awaiting review: the child creates them; a linked
      // parent reads and resolves (deletes) them.
      match /pendingApps/{pkg} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow create, update: if request.auth != null && request.auth.uid == childId;
      }

      // Geofence events: the child reports them; a linked parent reads them.
      match /geofenceEvents/{eventId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow create: if request.auth != null && request.auth.uid == childId;
      }

      // On-demand commands (e.g. screenshot): a linked parent writes the request;
      // the child reads it. (The catch-all below is the opposite way round.)
      match /commands/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents;
      }

      // Captured screenshots: the child uploads records; a linked parent reads and
      // deletes them.
      match /screenshots/{shotId} {
        allow read, delete: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow create: if request.auth != null && request.auth.uid == childId;
      }

      match /{document=**} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents;
        allow write: if request.auth != null && request.auth.uid == childId;
      }
    }
  }
}
