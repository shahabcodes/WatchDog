rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: a user may write only their own avatar (<uid>.jpg). Reads are
    // scoped to the owner and — for a child's avatar — that child's linked
    // parents, rather than every signed-in user (avoids cross-tenant PII reads).
    match /avatars/{imageId} {
      allow read: if request.auth != null && (
        imageId == request.auth.uid + '.jpg' ||
        request.auth.uid in firestore.get(/databases/(default)/documents/children/$(imageId.split('[.]')[0])).data.linkedParents
      );
      allow write: if request.auth != null
                   && imageId == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Child screenshots: only the child device uploads; the child or a linked
    // parent may read; the parent (or child) may delete after the parent has
    // downloaded it locally (screenshots are not kept server-side).
    match /screenshots/{childId}/{file} {
      // Only a supervised child (at least one linked parent), with a plain
      // "<millis>.jpg" name, so an unlinked or made-up account can't use the
      // bucket as free storage. A lifecycle rule also deletes leftovers.
      allow create: if request.auth != null
                    && request.auth.uid == childId
                    && file.matches('^[0-9]{1,15}[.](jpg|png)$')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*')
                    && firestore.get(/databases/(default)/documents/children/$(childId)).data.linkedParents.size() > 0;
      allow read, delete: if request.auth != null && (
        request.auth.uid == childId ||
        request.auth.uid in firestore.get(/databases/(default)/documents/children/$(childId)).data.linkedParents
      );
    }
  }
}
