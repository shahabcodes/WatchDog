rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read/write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // FCM registration tokens for geofence push notifications. Only the owner
      // writes them; the geofence Cloud Function reads them via the Admin SDK.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // E2EE public-key directory: a device's public key, keyed by its uid. Public
    // keys are not secret, so any signed-in user may fetch one by uid (a child
    // fetches a linked parent's key to wrap its data key) — but not LIST the
    // collection, which would enumerate every account id. Only the owner writes.
    match /publicKeys/{uid} {
      allow get: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['e2ePublicKey', 'aad2']);

      // One key per Watch Dog install. A child lists a linked parent's devices
      // (the uid must already be known; this doesn't enumerate accounts).
      match /devices/{deviceId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['e2ePublicKey', 'aad2', 'model', 'updatedAt'])
          && request.resource.data.e2ePublicKey is string
          && request.resource.data.e2ePublicKey.size() < 400
          && request.resource.data.get('model', '') is string
          && request.resource.data.get('model', '').size() <= 60;
      }
    }

    // Hashed two-factor backup codes. Server-only: the backup-code Cloud
    // Functions read and write them with the Admin SDK; no client access at all.
    match /mfaBackupCodes/{uid} {
      allow read, write: if false;
    }

    // Server-only bookkeeping (Cloud Functions, Admin SDK): pairing codes (hashed),
    // attempt counters, and server-time heartbeats for tamper alerts.
    match /pairingInvites/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }
    match /childMonitor/{id} {
      allow read, write: if false;
    }
    // Removal-PIN hashes (pin.js): never readable by any app, so the child
    // can't copy the hash and brute-force it offline.
    match /pinSecrets/{id} {
      allow read, write: if false;
    }

    // Child account documents.
    //
    // Threat model: the child device's own account must be treated as the child
    // (who can extract its token). So anything that weakens supervision —
    // linkedParents, pairing, rules, grants — is parent- or server-only, and every
    // collection lists its writers explicitly (there is no write catch-all).
    match /children/{childId} {
      // --- access helpers -------------------------------------------------
      function childDoc() {
        return get(/databases/$(database)/documents/children/$(childId)).data;
      }
      function isChild() {
        return request.auth != null && request.auth.uid == childId;
      }
      function isParent() {
        return request.auth != null && request.auth.uid in childDoc().linkedParents;
      }
      function canRead() { return isChild() || isParent(); }
      // Whether this child is currently encrypting (all linked parents wrapped);
      // the child publishes `encActive` on its doc from its heartbeat.
      function encActive() { return childDoc().encActive == true; }
      // A create/update to an E2EE collection must carry the encrypted form once
      // encryption is active, so a (co-)parent can't silently downgrade/forge a
      // plaintext value. Only valid for create/update (request.resource exists).
      function encWriteOk() { return !encActive() || request.resource.data.enc == true; }
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      // Fields the child device may write on its own doc. Never linkedParents or
      // the pairing fields: only the pairing Cloud Functions change those.
      function childDocFieldsOk() {
        return (!('role' in request.resource.data) || request.resource.data.role == 'CHILD')
          && (!('profile' in request.resource.data) || !('name' in request.resource.data.profile)
              || (request.resource.data.profile.name is string && request.resource.data.profile.name.size() <= 60));
      }
      // --------------------------------------------------------------------

      // Only the child device and its linked parents may read the child doc. Uses
      // resource.data directly so a parent's whereArrayContains(linkedParents)
      // query is allowed per-doc.
      allow read: if request.auth != null && (
                    request.auth.uid == childId ||
                    request.auth.uid in resource.data.linkedParents
                  );

      // The child device creates its doc unsupervised (no parents) ...
      allow create: if isChild()
                    && request.resource.data.keys().hasOnly(['profile', 'role', 'device', 'encActive', 'linkedParents'])
                    && (!('linkedParents' in request.resource.data) || request.resource.data.linkedParents.size() == 0)
                    && childDocFieldsOk();
      // ... and afterwards may only update its profile and device status.
      allow update: if isChild()
                    && changedOnly(['profile', 'role', 'device', 'encActive'])
                    && childDocFieldsOk();
      // No client deletes and no parent writes here: linking, unlinking and
      // reconnecting go through Cloud Functions (pairing.js / reconnectChild).

      // Parent requests awaiting approval on the child's phone (written by the
      // linkChild function). The child lists them; a parent sees its own.
      match /parentRequests/{parentUid} {
        allow read: if isChild() || (request.auth != null && request.auth.uid == parentUid);
      }

      // App block/limit rules (E2EE): parents author them; the child only reads.
      // (New apps the child auto-blocks go to pendingApps instead.)
      match /appRules/{packageName} {
        allow read: if canRead();
        allow delete: if isParent();
        allow create, update: if isParent() && encWriteOk();
      }

      // App inventory: the child writes it; child/parent read it.
      match /inventory/{docId} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Geofences (E2EE): a parent authors them; the child reads to enforce.
      match /geofences/{geoId} {
        allow read: if canRead();
        allow delete: if isParent();
        allow create, update: if isParent() && encWriteOk();
      }

      // Screen-time usage: the child writes it; child/parent read it.
      match /usage/{date} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Live device state: the child publishes location + location status; a
      // parent starts a ring; the child may only switch a ring off.
      match /live/{docId} {
        allow read: if canRead();
        allow write: if isChild() && (docId == 'location' || docId == 'locationStatus');
        allow create, update: if isParent() && docId == 'ring'
          && request.resource.data.keys().hasOnly(['active', 'message', 'nonce', 'requestedAtMillis']);
        allow update: if isChild() && docId == 'ring'
          && changedOnly(['active']) && request.resource.data.active == false;
      }

      // Location trail (continuous path): the child appends points.
      match /trail/{date} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Travel history: the child records stops.
      match /travelHistory/{stopId} {
        allow read: if canRead();
        allow create: if isChild();
      }

      // Settings (protection PIN, focus, tracking, install guard): a parent writes
      // them; the child enforces (reads). focus + installGuard are E2EE, so once
      // encryption is active they must be written encrypted (anti-downgrade);
      // protection + tracking are plaintext by design and exempt.
      match /settings/{docId} {
        allow read: if canRead();
        allow delete: if isParent();
        allow create, update: if isParent()
          && (!(docId == 'focus' || docId == 'installGuard') || encWriteOk())
          && (docId != 'protection' || noPinFields());
      }
      // The removal PIN is set and checked only by Cloud Functions (pin.js).
      function noPinFields() {
        return request.method == 'create'
          ? !request.resource.data.keys().hasAny(['pin', 'pinSalt', 'pinHash', 'hasPin'])
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin', 'pinSalt', 'pinHash', 'hasPin']);
      }

      // New apps awaiting review: the child adds them (and blocks them until a
      // parent decides); only a parent resolves (deletes) them.
      match /pendingApps/{pkg} {
        allow read: if canRead();
        allow delete: if isParent();
        // Bounded text: the label goes into the parent's notification.
        allow create, update: if isChild()
          && request.resource.data.keys().hasOnly(['packageName', 'label', 'installedAtMillis'])
          && request.resource.data.get('label', '') is string
          && request.resource.data.get('label', '').size() <= 100
          && request.resource.data.get('packageName', '') is string
          && request.resource.data.get('packageName', '').size() <= 255;
      }

      // Child "asks" (more time, unlock an app): the child creates a PENDING ask
      // and may withdraw it while pending; only a parent approves or denies.
      match /requests/{requestId} {
        allow read: if canRead();
        allow create: if isChild()
          && request.resource.data.keys().hasOnly(
               ['kind', 'appPackage', 'appLabel', 'minutes', 'status', 'createdAtMillis', 'respondedAtMillis'])
          && request.resource.data.status == 'PENDING'
          && request.resource.data.get('respondedAtMillis', 0) == 0
          && request.resource.data.get('appLabel', '') is string
          && request.resource.data.get('appLabel', '').size() <= 100;
        allow delete: if isChild() && resource.data.status == 'PENDING';
        allow update: if isParent()
          && changedOnly(['status', 'respondedAtMillis', 'grantUntilMillis'])
          && request.resource.data.status in ['APPROVED', 'DENIED'];
      }

      // Geofence events: the child reports them; a parent reads/clears.
      match /geofenceEvents/{eventId} {
        allow read: if canRead();
        allow delete: if isParent();
        allow create: if isChild();
      }

      // On-demand commands (screenshot, location refresh, permission ask): a
      // parent writes them; the child reports screenshot progress.
      match /commands/{docId} {
        allow read: if canRead();
        allow write: if isParent() && docId != 'screenshotStatus';
        allow write: if isChild() && docId == 'screenshotStatus';
      }

      // E2EE key exchange: the child writes a per-recipient wrapped data key; the
      // matching parent reads its own copy. Only ciphertext.
      match /e2eeKeys/{recipientUid} {
        allow read: if canRead();
        allow write: if isChild();

        // The data key wrapped for one of that parent's devices.
        match /devices/{deviceId} {
          allow read: if canRead();
          allow write: if isChild();
        }
      }

      // A parent that can't decrypt asks the child to re-wrap the data key for it
      // now. The requester may only write its own request doc; the child honours
      // and clears it (the requester may also read/clear its own).
      match /keyResync/{recipientUid} {
        allow create, update: if canRead() && request.auth.uid == recipientUid;
        allow read, delete: if isChild() || request.auth.uid == recipientUid;
      }

      // Captured screenshots: the child uploads records; a parent reads and
      // deletes them (a Cloud Function then deletes the stored image).
      match /screenshots/{shotId} {
        allow read: if canRead();
        allow delete: if isParent();
        allow create: if isChild();
      }

      // Anything else below a child: readable by the family, written by no client.
      match /{document=**} {
        allow read: if canRead();
      }
    }
  }
}
