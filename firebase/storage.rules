rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: a user may write only their own avatar; any signed-in user may read.
    match /avatars/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Child screenshots: only the child device uploads; the child or a linked
    // parent may read.
    match /screenshots/{childId}/{file} {
      allow write: if request.auth != null
                   && request.auth.uid == childId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && (
        request.auth.uid == childId ||
        request.auth.uid in firestore.get(/databases/(default)/documents/children/$(childId)).data.linkedParents
      );
    }
  }
}
