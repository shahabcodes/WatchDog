rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read/write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Child account documents.
    match /children/{childId} {
      // Any signed-in user may read a child doc. This is needed so a parent can
      // verify a scanned pairing code before linking. Tighten in production by
      // moving linking to a Cloud Function (then restrict reads to linkedParents).
      allow read: if request.auth != null;

      // The child device owns its document.
      allow create, update, delete: if request.auth != null && request.auth.uid == childId;

      // A signed-in parent may link themselves while pairing is active, and may
      // ONLY change the linkedParents field.
      allow update: if request.auth != null
                    && resource.data.pairingActive == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParents']);

      // App usage rules: a linked parent or the child may read/write.
      match /appRules/{packageName} {
        allow read, write: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
      }

      // App inventory: the child writes it; a linked parent (or the child) reads it.
      match /inventory/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow write: if request.auth != null && request.auth.uid == childId;
      }

      // Geofences: a linked parent authors them; the child reads them.
      match /geofences/{geoId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
      }

      // Geofence events: the child reports them; a linked parent reads them.
      match /geofenceEvents/{eventId} {
        allow read: if request.auth != null && (
          request.auth.uid == childId ||
          request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents
        );
        allow create: if request.auth != null && request.auth.uid == childId;
      }

      match /{document=**} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.linkedParents;
        allow write: if request.auth != null && request.auth.uid == childId;
      }
    }
  }
}
