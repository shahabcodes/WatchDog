# Normalize line endings. Keep LF for everything text so CI shell/YAML is safe.
* text=auto eol=lf

# Explicitly LF for scripts and config that run on Linux CI.
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Windows batch files stay CRLF.
*.bat text eol=crlf

# Binary files.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.keystore binary
*.jks binary
