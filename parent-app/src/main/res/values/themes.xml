<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Compose drives the actual UI; this only styles the
         window before/around Compose. Uses a platform Material theme to avoid a
         dependency on the Material Components view library. -->
    <style name="Theme.ParentApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
