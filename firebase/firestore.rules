rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user may read/write only their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // FCM registration tokens for geofence push notifications. Only the owner
      // writes them; the geofence Cloud Function reads them via the Admin SDK.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // E2EE public-key directory: a device's public key, keyed by its uid. Public
    // keys are not secret, so any signed-in user may read one (needed so a child
    // can fetch a linked parent's key to wrap its data key); only the owner may
    // write their own.
    match /publicKeys/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Child account documents.
    match /children/{childId} {
      // --- access helpers -------------------------------------------------
      function childDoc() {
        return get(/databases/$(database)/documents/children/$(childId)).data;
      }
      function isChild() {
        return request.auth != null && request.auth.uid == childId;
      }
      function isParent() {
        return request.auth != null && request.auth.uid in childDoc().linkedParents;
      }
      function canRead() { return isChild() || isParent(); }
      function isChildOrParent() { return isChild() || isParent(); }
      // --------------------------------------------------------------------

      // Only the child device and its already-linked parents may read the child
      // doc (profile + pairing code). Uses resource.data directly so a parent's
      // whereArrayContains(linkedParents) query is allowed per-doc. Pairing-code
      // verification and linking happen server-side in the linkChild Cloud
      // Function (Admin SDK), so no pre-link client read of this doc is needed.
      allow read: if request.auth != null && (
                    request.auth.uid == childId ||
                    request.auth.uid in resource.data.linkedParents
                  );

      // The child device owns its document.
      allow create, update, delete: if request.auth != null && request.auth.uid == childId;

      // Linking is done by the linkChild Cloud Function (it verifies the pairing
      // code server-side and adds only the caller), so there is deliberately NO
      // client-writable linking rule here.

      // A linked parent may remove (unlink) themselves, updating linkedParents
      // (and re-opening pairing); they must not remain linked afterwards.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.linkedParents
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedParents', 'pairingActive'])
                    && !(request.auth.uid in request.resource.data.linkedParents);

      // The child and its linked parents read everything below; writes are
      // restricted per collection to the child and/or parents as noted.

      // App usage rules: child/parent read/write; viewers read.
      match /appRules/{packageName} {
        allow read: if canRead();
        allow write: if isChildOrParent();
      }

      // App inventory: the child writes it; child/parent/viewer read it.
      match /inventory/{docId} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Geofences: a parent authors them; the child reads them to enforce; viewers read.
      match /geofences/{geoId} {
        allow read: if canRead();
        allow write: if isChildOrParent();
      }

      // Screen-time usage: the child writes it; child/parent/viewer read it.
      match /usage/{date} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Live device state (location + ring command): the child publishes location
      // and clears rings; a parent reads location and sends rings; viewers read.
      match /live/{docId} {
        allow read: if canRead();
        allow write: if isChildOrParent();
      }

      // Location trail (continuous path): the child appends points; child/parent/viewer read.
      match /trail/{date} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // Travel history: the child records stops; child/parent/viewer read.
      match /travelHistory/{stopId} {
        allow read: if canRead();
        allow create: if isChild();
      }

      // Settings (protection PIN, focus, tracking, install guard):
      // a parent writes them; the child enforces (reads).
      match /settings/{docId} {
        allow read: if canRead();
        allow write: if isParent();
      }

      // Auto-blocked new apps awaiting review: the child creates them; a parent
      // resolves (deletes); viewers read.
      match /pendingApps/{pkg} {
        allow read: if canRead();
        allow delete: if isChildOrParent();
        allow create, update: if isChild();
      }

      // Child "asks" (more time, unlock an app): the child creates; child/parent
      // respond (approve/deny); viewers read.
      match /requests/{requestId} {
        allow read: if canRead();
        allow create: if isChild();
        allow update, delete: if isChildOrParent();
      }

      // Geofence events: the child reports them; a parent reads/clears; viewers read.
      match /geofenceEvents/{eventId} {
        allow read: if canRead();
        allow delete: if isChildOrParent();
        allow create: if isChild();
      }

      // On-demand commands (e.g. screenshot/ring): a parent writes the request;
      // the child reads it; viewers read but cannot issue commands.
      match /commands/{docId} {
        allow read: if canRead();
        allow write: if isParent();
      }

      // E2EE key exchange: the child writes a per-recipient wrapped data key; the
      // matching parent/viewer reads its own copy. Only ciphertext — never a
      // private key or plaintext.
      match /e2eeKeys/{recipientUid} {
        allow read: if canRead();
        allow write: if isChild();
      }

      // A parent/viewer that can't decrypt asks the child to re-wrap the data key
      // for it now. The requester may only write its own request doc; the child
      // honours and clears it (the requester may also read/clear its own).
      match /keyResync/{recipientUid} {
        allow create, update: if canRead() && request.auth.uid == recipientUid;
        allow read, delete: if isChild() || request.auth.uid == recipientUid;
      }

      // Captured screenshots: the child uploads records; a parent reads and
      // deletes them; viewers read.
      match /screenshots/{shotId} {
        allow read: if canRead();
        allow delete: if isChildOrParent();
        allow create: if isChild();
      }

      match /{document=**} {
        allow read: if canRead();
        allow write: if isChild();
      }
    }
  }
}
